{
  "name": "@sbtc/sdk",
  "version": "0.0.1",
  "description": "Universal React SDK for sBTC and Stacks — works on React Native / Expo and React (web) from a single install.",
  "license": "MIT",
  "keywords": [
    "sbtc",
    "stacks",
    "bitcoin",
    "react",
    "react-native",
    "expo",
    "wallet"
  ],
  "sideEffects": [
    "./dist/polyfills.js",
    "./dist/polyfills.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./polyfills": {
      "types": "./dist/polyfills.d.ts",
      "import": "./dist/polyfills.mjs",
      "require": "./dist/polyfills.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "size-check": "bundlesize"
  },
  "bundlesize": [
    {
      "path": "./dist/index.mjs",
      "maxSize": "60 kB",
      "compression": "gzip"
    },
    {
      "path": "./dist/polyfills.mjs",
      "maxSize": "80 kB",
      "compression": "gzip"
    }
  ],
  "peerDependencies": {
    "@stacks/connect": ">=7",
    "expo-local-authentication": ">=14",
    "expo-secure-store": ">=13",
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-local-authentication": {
      "optional": true
    },
    "@stacks/connect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "bundlesize2": "^0.0.35",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
